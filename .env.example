# Скопируйте в .env и заполните. НЕ коммитьте .env.
#   cp .env.example .env  &&  chmod 600 .env

# --- Actual Budget ---
# Пароль сервера Actual — задайте любой при первом входе на http://localhost:5006,
# затем впишите его сюда (нужен контейнерам синка, категоризации и дашборду).
ACTUAL_PASSWORD=

# Sync ID вашего бюджета: Actual UI → Settings → Advanced settings → Sync ID
ACTUAL_BUDGET_SYNC_ID=

# --- Общее ---
TZ=Europe/Warsaw
# Какие сервисы поднимать помимо actual-server: sync,ai (через запятую)
COMPOSE_PROFILES=sync

# Название группы категорий, которую аналитика исключает из cash flow
# (переводы между счетами, обмены валют, отменённые платежи).
# Создайте такую группу в своём бюджете и укажите её имя здесь.
EXCLUDED_GROUP=Переводы и обмены

# --- Автосинк банков (actual-auto-sync), ежедневно ---
AUTO_SYNC_CRON=30 7 * * *

# --- Бэкапы (./cashflow.sh backup и autobackup) ---
# Куда складывать консистентные снапшоты data/actual. По умолчанию — iCloud Drive.
# Можно указать любую папку (напр. внешний диск). Хранятся последние BACKUP_KEEP штук.
ICLOUD_BACKUP_DIR=$HOME/Library/Mobile Documents/com~apple~CloudDocs/CashFlow
BACKUP_KEEP=30

# --- Категоризация (actual-ai, опционально, профиль ai) ---
AI_CRON=0 8 * * *
# Провайдер LLM: openai | anthropic | ollama.
# Пример ниже — локальный LM Studio (OpenAI-совместимый API на хосте).
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=google/gemma-3-4b
# Первый прогон — с dryRun (покажет план без изменений). Уберите после проверки.
AI_FEATURES=["classifyOnStartup","syncAccountsBeforeClassify","rerunMissedTransactions","dryRun"]
