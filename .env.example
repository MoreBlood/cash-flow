# Скопируйте в .env и заполните. НЕ коммитьте .env.
#   cp .env.example .env  &&  chmod 600 .env

TZ=Europe/Warsaw

# --- Enable Banking (банковский синк) ---
# Application ID из панели enablebanking.com и путь к приватному ключу
# (относительно корня репозитория; файл обычно называется <app-id>.pem).
EB_APP_ID=
EB_KEY_FILE=secrets/<app-id>.pem

# Автосинк банков: локальное время, через запятую. PSD2 разрешает не больше
# 4 фоновых запросов к банку в сутки — не ставьте больше 2–3 запусков.
AUTO_SYNC_TIMES=07:30

# --- Бэкапы ---
# Куда класть снапшоты базы (после каждого синка) и полный бандл (backup --full).
# По умолчанию iCloud Drive; можно любой каталог. Хранятся последние BACKUP_KEEP.
ICLOUD_BACKUP_DIR=$HOME/Library/Mobile Documents/com~apple~CloudDocs/CashFlow
BACKUP_KEEP=30
