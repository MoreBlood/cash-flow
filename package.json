{
  "name": "cashflow",
  "private": true,
  "type": "module",
  "description": "Личные финансы: Enable Banking + SQLite/Turso + дашборд и MCP. Локально (launchd) или на Vercel.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm ci --prefix web --no-fund --no-audit && npm run build --prefix web && node src/migrate.ts",
    "start": "node --disable-warning=ExperimentalWarning src/local.ts",
    "migrate": "node --disable-warning=ExperimentalWarning src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "node --disable-warning=ExperimentalWarning scripts/gen-auth-schema.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.7",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9"
  }
}
